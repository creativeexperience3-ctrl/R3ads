rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // R3ads Portal Clínico — Reglas multi-tenant
    //
    // Origen: portado de CMG-Website/firestore.rules (sistema de una sola
    // clínica). Cambio central: en el original, el rol de cada usuario se
    // resolvía por LISTAS DE CORREOS hardcodeadas dentro de estas mismas
    // reglas (isDoctor/isCaja/isAdmin/isMedicoTratante). Eso es exactamente
    // lo que NO puede existir en una plataforma multi-clínica: cada clínica
    // tiene su propio staff, y ningún correo puede estar "quemado" aquí.
    //
    // Aquí el rol y la clínica del usuario vienen SOLO de custom claims de
    // Firebase Auth (`rol`, `clinicId`), fijados por una Cloud Function al
    // escribir /usuarios/{uid} (ver Fase 3 del plan — pendiente de crear esa
    // función en este repo). Cada documento clínico lleva su propio
    // `clinicId`, y toda regla de rol exige ADEMÁS que el clinicId del token
    // coincida con el clinicId del documento. Sin esa coincidencia, no hay
    // rol que valga — así es imposible que el staff de una clínica lea o
    // escriba datos de otra, incluso si el rol coincide.
    // ═══════════════════════════════════════════════════════════════

    // ── Identidad básica ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function myClinic() {
      return request.auth.token.clinicId;
    }
    function myRole() {
      return request.auth.token.rol;
    }

    // ── Segundo factor (2FA) ──────────────────────────────────────
    // Los claims `mfa` y `mfaUntil` los fija verificar2FA/confirmar2FA
    // (functions/index.js) al validar un código TOTP. Acá está el candado
    // real: sin esto el 2FA sería solo interfaz, y cualquiera con la
    // contraseña podría hablarle a Firestore directo con el SDK y saltárselo.
    //
    // Clave del diseño: solo exige algo si el token YA trae `mfa == true`,
    // o sea solo a quien terminó de activar su segundo factor. Quien no lo
    // activó no tiene ese claim y estas reglas se comportan igual que antes
    // — activar esta función NO puede dejar afuera a nadie que no se haya
    // enrolado él mismo. Por eso el .get() con default en vez de leer el
    // campo directo: un token sin el claim no debe tronar la evaluación.
    function mfaVigente() {
      return request.auth.token.get('mfa', false) != true
        || request.auth.token.get('mfaUntil', 0) > request.time.toMillis();
    }
    // Cuentas internas de R3ads (soporte/operación de la plataforma), NO de
    // ninguna clínica. Se otorga a mano una sola vez por Firebase Admin SDK
    // al crear la cuenta del equipo de R3ads — nunca por una lista de correos
    // en este archivo. Alcance limitado a administrar /clinics y bootstrap de
    // /usuarios; NO da acceso a expedientes/consultas de ninguna clínica.
    // mfaVigente(): la cuenta que administra TODAS las clínicas es la que más
    // conviene proteger con segundo factor. Igual que arriba, solo aplica si
    // ese superadmin ya activó su 2FA.
    function isSuperAdmin() {
      return isAuth() && request.auth.token.superadmin == true && mfaVigente();
    }

    // Clínica con la suscripción vigente. Si una clínica se suspende por falta
    // de pago (Fase 6 del plan), esto corta el acceso de todo su staff a la
    // vez, sin tener que tocar ninguna otra regla.
    function clinicActiva(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId))
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.estado == 'activa';
    }
    // El usuario pertenece a esa clínica Y esa clínica está activa.
    // mfaVigente() va acá —y no en cada rol— porque TODOS los roles
    // (isDoctor/isCaja/isAdmin/isEnfermeria/isMedicoTratante) pasan por esta
    // función: un solo punto de control en vez de cinco que se desincronizan.
    function sameClinic(clinicId) {
      return isAuth() && mfaVigente() && myClinic() == clinicId && clinicActiva(clinicId);
    }

    // ── Roles (idéntica jerarquía al sistema original de CMG) ───────
    // isCaja: recepción/cobros. Rol Firestore: caja | enf | admin.
    function isCaja(clinicId) {
      return sameClinic(clinicId) && myRole() in ['caja', 'enf', 'admin'];
    }
    // isDoctor: acceso clínico completo. Rol Firestore: medico | enf | admin.
    function isDoctor(clinicId) {
      return sameClinic(clinicId) && myRole() in ['medico', 'enf', 'admin'];
    }
    // isAdmin: acceso total a portales y configuración de SU clínica.
    function isAdmin(clinicId) {
      return sameClinic(clinicId) && myRole() == 'admin';
    }
    // isEnfermeria: personal de enfermería. Rol Firestore: enf | admin.
    function isEnfermeria(clinicId) {
      return sameClinic(clinicId) && myRole() in ['enf', 'admin'];
    }
    // isMedicoTratante: SOLO médico (rol medico | admin). A diferencia de
    // isDoctor(), NO incluye enfermería — se usa para la finalización de la
    // Consulta médica (diagnóstico/tratamiento), reservada al médico tratante.
    function isMedicoTratante(clinicId) {
      return sameClinic(clinicId) && myRole() in ['medico', 'admin'];
    }

    // esServicioEnfermeria: en el original esto era una lista de nombres de
    // servicios hardcodeada aquí mismo (catálogo específico de CMG, ej.
    // "Sueroterapia Glutatión"). En multi-tenant cada clínica tiene su propio
    // catálogo (clinics/{clinicId}/catalogoConfig — ver más abajo), así que
    // la marca "¿enfermería puede completar este servicio sola?" tiene que
    // vivir ahí, no en este archivo.
    //
    // CONFIRMADO al portar Admin-Precios.html: la clave real de cada ítem en
    // catalogoConfig NO es el nombre del servicio, es un slug
    // `{categoria}__{nombre-slugificado}` (ver slug() en Admin-Precios.html).
    // Por eso este helper recibe `servicioKey` (no el nombre) — Expediente-
    // Doctor.html debe guardar ese mismo `servicioKey` en cada `consulta` al
    // crearla (pendiente al portar ese archivo), calculado con la misma
    // función slug() para que coincida exactamente con el ID en Firestore.
    // Mientras el ítem no tenga ese doc o ese campo, esta función devuelve
    // false (fail-closed): el servicio requiere médico tratante por defecto.
    function esServicioEnfermeria(clinicId, servicioKey) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId)/catalogoConfig/$(servicioKey))
        && get(/databases/$(database)/documents/clinics/$(clinicId)/catalogoConfig/$(servicioKey)).data.enfermeriaCompletable == true;
    }

    // moduloActivo: ¿esta clínica tiene contratado este módulo?
    // Se guarda en /clinics/{clinicId}.modulos como mapa de banderas
    // ({ laboratorio: true, pruebasRapidas: false, ... }), escrito SOLO por
    // superadmin (es decisión de facturación, no de la clínica).
    //
    // Misma semántica que clinic-modules.js en el cliente, y tiene que
    // quedarse igual a propósito: si el mapa NO existe, todo habilitado
    // (compatibilidad con las clínicas dadas de alta antes de esto); si
    // existe, solo lo que está en true.
    //
    // Esto es el candado de verdad. Esconder botones en el cliente no
    // impide que alguien escriba directo contra Firestore.
    //
    // Se da por hecho que la clínica existe: moduloActivo() siempre se usa
    // detrás de un isDoctor()/isCaja(), que ya pasaron por clinicActiva() y
    // por lo tanto por exists(). Se evita repetir ese exists() acá porque
    // cada acceso a documento cuenta contra el límite por evaluación. Si
    // alguna vez se usa sin ese guard y la clínica no existe, la regla da
    // error, que en Firestore significa denegar — falla cerrado.
    function moduloActivo(clinicId, nombre) {
      return !('modulos' in get(/databases/$(database)/documents/clinics/$(clinicId)).data)
        || get(/databases/$(database)/documents/clinics/$(clinicId)).data.modulos.get(nombre, false) == true;
    }

    // accesoPaciente: ¿el usuario logueado es el dueño (ownerUid) del
    // expediente `codigo`, o está en su compartidoCon? Usado por el portal
    // separado web/portal-paciente/ para leer consultas/pruebas/laboratorio
    // de SU propio expediente (o el de un familiar que le compartió acceso),
    // sin necesitar clinicId — el paciente no tiene ese custom claim.
    // Usa .get('campo', default) y no .campo: los expedientes creados antes
    // de que existiera el portal de paciente no tienen ninguno de los dos
    // campos, y leer un campo ausente es un error de evaluación.
    function accesoPaciente(codigo) {
      return exists(/databases/$(database)/documents/expedientes/$(codigo))
        && (
          get(/databases/$(database)/documents/expedientes/$(codigo)).data.get('ownerUid', null) == request.auth.uid
          || (
            get(/databases/$(database)/documents/expedientes/$(codigo)).data.get('compartidoCon', []) is list
            && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(codigo)).data.get('compartidoCon', [])
          )
        );
    }

    // ═══ /clinics/{clinicId} ═══════════════════════════════════════
    // Ficha de la clínica: nombre, logo, colores, prefijo de código de
    // paciente, estado de suscripción ('activa' | 'suspendida').
    // Solo R3ads (superadmin) puede crear/editar clínicas o cambiar su
    // estado de suscripción — esto NO lo hace la propia clínica.
    match /clinics/{clinicId} {
      allow read: if isSuperAdmin() || (isAuth() && myClinic() == clinicId);
      allow write: if isSuperAdmin();

      // ═══ /clinics/{clinicId}/catalogoConfig/{itemKey} ═════════════
      // Catálogo de servicios/precios propio de la clínica (reemplaza el
      // catalogoConfig global del sistema de una sola clínica).
      // Lectura PÚBLICA: heredado de cuando existía el Cotizador anónimo,
      // que ya se removió. Hoy solo lo leen páginas con sesión, así que
      // esto podría cerrarse a isAuth() — son precios, no PII, por eso no
      // se tocó todavía.
      // Escritura: solo admin de esa clínica o superadmin.
      match /catalogoConfig/{itemKey} {
        allow read: if true;
        allow write: if isAdmin(clinicId) || isSuperAdmin();
      }

      // ═══ /clinics/{clinicId}/siteConfig/{docId} ═══════════════════
      // Configuración pública del micrositio de esa clínica (horario,
      // anuncio, contacto). Lectura pública, escritura solo admin/superadmin.
      match /siteConfig/{docId} {
        allow read: if true;
        allow write: if isAdmin(clinicId) || isSuperAdmin();
      }

      // ═══ /clinics/{clinicId}/personal/{personalId} ════════════════
      // Nombres de médicos/enfermería para el selector "Atendido por" en
      // Expediente-Doctor.html (Personal.html los administra) — reemplaza
      // el array PERSONAL_ATIENDE hardcodeado a CMG que traía el port.
      // Lectura: cualquier staff activo de ESTA clínica (no público, a
      // diferencia de catalogoConfig — son nombres de personal, no precios).
      // Escritura: solo admin de esa clínica o superadmin.
      match /personal/{personalId} {
        allow read: if sameClinic(clinicId);
        allow write: if isAdmin(clinicId) || isSuperAdmin();
      }

      // ═══ /clinics/{clinicId}/proveedores/{proveedorId} ════════════
      // Laboratorios a los que esta clínica manda las muestras, para el
      // selector "Proveedor (laboratorio)" al solicitar exámenes
      // (Proveedores.html los administra). Mismo caso que /personal: eran
      // tres <option> hardcodeados a CMG (Labex, Masterlab, Laboratorio
      // Rivera) dentro de Expediente-Doctor.html, así que toda clínica del
      // SaaS veía los proveedores de otra y no podía cargar los suyos.
      // Lectura: staff activo de ESTA clínica. Escritura: solo admin.
      match /proveedores/{proveedorId} {
        allow read: if sameClinic(clinicId);
        allow write: if isAdmin(clinicId) || isSuperAdmin();
      }

      // ═══ /clinics/{clinicId}/medicamentos/{medId} ═════════════════
      // Catálogo de medicamentos propio de la clínica (nombre, tipo
      // visita/despacho/ambos, precio, excluidoDescuento) — reemplaza
      // MEDS_VISITA_CATS/MEDS_DESPACHO_CATS hardcodeados a CMG. Mismo
      // patrón de acceso que /personal: lectura para cualquier staff de
      // ESTA clínica, escritura solo admin/superadmin (Medicamentos.html).
      match /medicamentos/{medId} {
        allow read: if sameClinic(clinicId);
        allow write: if isAdmin(clinicId) || isSuperAdmin();
      }
    }

    // ═══ /_claimsRefresh/{uid} ═══════════════════════════════════════
    // Escrita SOLO por la Cloud Function onUsuarioWrite (Admin SDK, que
    // ignora estas reglas) cada vez que cambian los custom claims de un
    // usuario. El propio usuario la escucha (onSnapshot) para saber cuándo
    // debe forzar un refresh de su ID token — ver r3ads-staff.js. Nadie
    // escribe aquí desde el cliente.
    match /_claimsRefresh/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if false;
    }

    // ═══ /usuarios/{uid} ═══════════════════════════════════════════
    // Cuentas de STAFF (personal clínico/caja/admin), gestionadas desde
    // Admin-Usuarios.html. Cada doc lleva clinicId. Solo el admin de esa
    // misma clínica administra a su propio personal; superadmin solo se usa
    // para el alta manual del primer admin de una clínica nueva (Fase 4).
    match /usuarios/{userId} {
      allow read: if (isAuth() && request.auth.uid == userId)
        || isAdmin(resource.data.clinicId)
        || isSuperAdmin();
      allow create: if isSuperAdmin() || isAdmin(request.resource.data.clinicId);
      // No se permite mover un usuario de una clínica a otra vía update.
      allow update: if isSuperAdmin()
        || (
          isAdmin(resource.data.clinicId)
          && request.resource.data.clinicId == resource.data.clinicId
        );
      allow delete: if isAdmin(resource.data.clinicId) || isSuperAdmin();
    }

    // ═══ /users/{uid} ══════════════════════════════════════════════
    // Perfil del PACIENTE (códigos de expediente vinculados/compartidos),
    // usado por el portal separado web/portal-paciente/ — no confundir con
    // /usuarios/{uid}, que es el staff de una clínica. Sin clinicId: un
    // paciente puede tener códigos de varias clínicas distintas en Ancla.
    match /users/{userId} {
      allow read: if (isAuth() && request.auth.uid == userId) || isSuperAdmin();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ═══ /expedientes/{codigo} ═════════════════════════════════════
    // Document ID = código del paciente, con prefijo de la clínica
    // (ej. {prefijo}-A7K9M2, ver Fase 2 del plan).
    match /expedientes/{codigo} {
      // Doctor/Caja de la MISMA clínica, o cualquier autenticado que conozca
      // el código — pero siempre dentro de la misma clínica activa.
      // resource == null: la petición es un get() a un código que todavía no
      // existe (ej. el chequeo de colisión al generar un código nuevo en
      // Expediente-Doctor.html). Sin este bypass, isDoctor()/isCaja()/
      // sameClinic() truenan al leer resource.data.clinicId de un resource
      // null, y un error de evaluación en las reglas se trata como negado —
      // bloqueaba crear expedientes nuevos. No expone nada: no hay data que
      // devolver para un documento que no existe.
      // Autoservicio de paciente (portal separado web/portal-paciente/):
      // el paciente lee su expediente por ser su DUEÑO (ownerUid) o por
      // estar en compartidoCon, no por conocer el código.
      //
      // Hasta el 2026-10-02 esta regla cerraba con un `|| isAuth()` suelto,
      // heredado del CMG original, donde el código de 6 caracteres hacía de
      // control de acceso. En CMG era una sola clínica; acá es un Firestore
      // multi-tenant, así que esa rama dejaba a cualquier cuenta logueada
      // leer el expediente de cualquier clínica con solo saber el código —
      // y el código viaja impreso en PDFs y por WhatsApp, no expira y no se
      // puede rotar. Era la única colección que rompía el aislamiento entre
      // clínicas: consultas/resultadosPruebas/examenesLaboratorio ya
      // filtraban por accesoPaciente(), que es por propiedad.
      //
      // Se usa .get('campo', default) y no .campo porque los expedientes
      // viejos no tienen estos campos, y leer un campo ausente es un error
      // de evaluación — que Firestore trata como denegado, pero también
      // corta las ramas de doctor/caja que vienen después.
      allow read: if (resource == null && isAuth())
        || isDoctor(resource.data.clinicId)
        || isCaja(resource.data.clinicId)
        || sameClinic(resource.data.clinicId)
        || (isAuth() && resource.data.get('ownerUid', null) == request.auth.uid)
        || (isAuth() && resource.data.get('compartidoCon', []) is list
            && request.auth.uid in resource.data.get('compartidoCon', []));

      // Solo el doctor de esa clínica crea expedientes, y el documento debe
      // nacer con el clinicId de quien lo crea (nunca "en blanco" ni de otra
      // clínica).
      allow create: if isDoctor(request.resource.data.clinicId)
        && request.resource.data.clinicId == myClinic();

      // Update:
      //   - Doctor de esa clínica: siempre, sin poder cambiar el clinicId.
      //   - Paciente que reclama su expediente: solo si la CLÍNICA ya anotó
      //     su correo en datosGenerales.email y el paciente demostró que ese
      //     buzón es suyo (email_verified). Ver la nota de abajo.
      //   - Paciente ya owner: solo puede tocar compartidoCon (aprobar o
      //     revocar el acceso de un familiar).
      //
      // Vinculación por correo verificado (2026-10-02). Antes bastaba con
      // conocer el código y encontrar el expediente sin ownerUid: cualquier
      // cuenta logueada podía quedar dueña permanente del expediente de un
      // desconocido, y con eso leer sus consultas, pruebas y laboratorios
      // vía accesoPaciente(). Ahora la credencial no es el código sino el
      // correo que la clínica registró al abrir el expediente — un campo que
      // el paciente no puede tocar, porque datosGenerales no está en el
      // hasOnly() de esta rama.
      //
      // email_verified es imprescindible, no un extra: Firebase deja crear
      // una cuenta con el correo de otra persona sin probar que es tuyo, así
      // que sin este chequeo el correo no probaría nada.
      //
      // Las solicitudes de acceso de un familiar ya no se escriben en un
      // array de este documento (ver la subcolección /solicitudes de abajo).
      allow update: if request.resource.data.clinicId == resource.data.clinicId
        && (
          isDoctor(resource.data.clinicId)
          || (
            isAuth()
            && request.auth.token.email_verified == true
            && resource.data.get('ownerUid', null) == null
            && resource.data.get('datosGenerales', {}).get('email', '').lower()
                == request.auth.token.email.lower()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['ownerUid', 'ownerVinculado', 'ownerEmail', 'updatedAt'])
          )
          || (
            isAuth()
            && resource.data.get('ownerUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['compartidoCon', 'updatedAt'])
          )
        );

      allow delete: if isDoctor(resource.data.clinicId);

      // ═══ /expedientes/{codigo}/solicitudes/{solicitanteUid} ══════
      // Un familiar pide acceso al expediente de otro. El id del documento
      // ES el uid del solicitante, y eso es el punto: la regla puede exigir
      // request.auth.uid == solicitanteUid y queda exacta.
      //
      // Antes esto vivía en un array `solicitudesAcceso` dentro del
      // expediente, con una rama de update que permitía a cualquier
      // autenticado reescribirlo completo — las reglas no pueden validar el
      // contenido de un arrayUnion, así que cualquiera que conociera el
      // código podía borrar las solicitudes de otros o inventar entradas.
      //
      // Pedir acceso no revela nada: crear este documento no requiere poder
      // leer el expediente, y el titular (único que puede leerlo) decide.
      // Aprobar = el titular agrega el uid a compartidoCon (rama de update
      // de arriba) y borra la solicitud.
      match /solicitudes/{solicitanteUid} {
        allow read: if isAuth() && (
          request.auth.uid == solicitanteUid
          || get(/databases/$(database)/documents/expedientes/$(codigo))
               .data.get('ownerUid', null) == request.auth.uid
        );
        // El solicitante crea y cancela la suya; el titular borra la que
        // rechaza o ya aprobó. Nadie edita una existente.
        allow create: if isAuth()
          && request.auth.uid == solicitanteUid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAuth() && (
          request.auth.uid == solicitanteUid
          || get(/databases/$(database)/documents/expedientes/$(codigo))
               .data.get('ownerUid', null) == request.auth.uid
        );
        allow update: if false;
      }
    }

    // ═══ /consultas/{id} ═══════════════════════════════════════════
    // Mismo flujo de estados que el original (listo_enfermeria → preclinica/
    // servicio → pendiente_caja/servicio-completo → completa), con clinicId.
    match /consultas/{consultaId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      // Rama de paciente (portal-paciente/Mi-Historial.html): ve las
      // consultas de SU expediente vinculado o compartido.
      allow read: if (resource == null && isAuth())
        || isDoctor(resource.data.clinicId)
        || isCaja(resource.data.clinicId)
        || (isAuth() && accesoPaciente(resource.data.codigoPaciente));

      allow create: if request.resource.data.clinicId == myClinic()
        && (
          isDoctor(request.resource.data.clinicId)
          || (isCaja(request.resource.data.clinicId)
              && request.resource.data.status == 'pendiente_caja'
              && request.resource.data.tipoRegistro in ['lab-standalone', 'prueba-standalone'])
          || (isCaja(request.resource.data.clinicId) && request.resource.data.status == 'listo_enfermeria')
          || (isCaja(request.resource.data.clinicId)
              && request.resource.data.status == 'servicio'
              && request.resource.data.tipo == 'servicio')
              // NOTA: el original tenía aquí una lista fija de servicios que
              // Caja registra directo sin preclínica ("Extracción de uña",
              // "Cirugía menor", etc. — servicios del catálogo que NO son
              // enfermeria-completable). Esa distinción también depende del
              // catálogo por clínica; falta el campo equivalente
              // (ej. `cajaRegistraDirecto`) al portar Admin-Precios.html.
              // Por ahora este create de Caja queda más permisivo que el
              // original hasta wirear ese campo — REVISAR antes de vender la
              // primera suscripción real.
        );

      allow delete: if isAdmin(resource.data.clinicId)
        || (
          isDoctor(resource.data.clinicId)
          && resource.data.status in ['listo_enfermeria', 'preclinica', 'servicio']
        );

      allow update: if request.resource.data.clinicId == resource.data.clinicId
        && (
          isMedicoTratante(resource.data.clinicId)
          || (
            isEnfermeria(resource.data.clinicId)
            && resource.data.status == 'listo_enfermeria'
            && request.resource.data.status in ['preclinica', 'servicio']
          )
          || (
            (isCaja(resource.data.clinicId) || isEnfermeria(resource.data.clinicId))
            && resource.data.status == 'servicio'
            && esServicioEnfermeria(resource.data.clinicId, resource.data.servicioKey)
            && request.resource.data.status in ['servicio', 'servicio-completo', 'pendiente_caja']
          )
          || (isCaja(resource.data.clinicId)
              && resource.data.status in ['pendiente_caja', 'servicio-completo']
              && request.resource.data.status in ['pendiente_caja', 'servicio-completo', 'completa'])
        );
    }

    // ═══ /resultadosPruebas/{id} ═══════════════════════════════════
    // OJO con el alcance de moduloActivo() acá y en las 3 colecciones de
    // abajo: se exige para ESCRIBIR, no para leer. Si una clínica da de
    // baja un módulo, deja de poder registrar cosas nuevas, pero sigue
    // viendo lo que ya tenía — son datos clínicos de sus pacientes, no se
    // le pueden ocultar por una decisión comercial.
    match /resultadosPruebas/{resultadoId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      // Rama de paciente (portal-paciente/Mi-Historial.html): ve las
      // pruebas rápidas de SU expediente vinculado o compartido.
      allow read: if (resource == null && isAuth())
        || isDoctor(resource.data.clinicId)
        || isCaja(resource.data.clinicId)
        || (isAuth() && accesoPaciente(resource.data.codigoPaciente));
      allow create, update: if (isDoctor(request.resource.data.clinicId) || isCaja(request.resource.data.clinicId))
        && moduloActivo(request.resource.data.clinicId, 'pruebasRapidas');
      allow delete: if isDoctor(resource.data.clinicId);
    }

    // ═══ /examenesLaboratorio/{id} ═════════════════════════════════
    match /examenesLaboratorio/{examenId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      // Rama de paciente: ve los exámenes de SU expediente vinculado o
      // compartido (subidos por CMG/la clínica o por él mismo).
      allow read: if (resource == null && isAuth())
        || isDoctor(resource.data.clinicId)
        || isCaja(resource.data.clinicId)
        || (isAuth() && accesoPaciente(resource.data.codigoPaciente));
      allow create: if (
          (isDoctor(request.resource.data.clinicId) || isCaja(request.resource.data.clinicId))
          && moduloActivo(request.resource.data.clinicId, 'laboratorio')
        )
        // Paciente sube su propio examen (portal-paciente/Mi-Historial.html):
        // solo a un expediente al que ya tiene acceso, y el clinicId debe
        // coincidir con el de ESE expediente (el paciente no elige clinicId
        // a mano — lo toma del documento que ya está leyendo).
        || (
          isAuth()
          && request.resource.data.subidoPorPaciente == true
          && request.resource.data.codigoPaciente is string
          && accesoPaciente(request.resource.data.codigoPaciente)
          && request.resource.data.clinicId ==
              get(/databases/$(database)/documents/expedientes/$(request.resource.data.codigoPaciente)).data.clinicId
          && moduloActivo(request.resource.data.clinicId, 'laboratorio')
        );
      allow update: if (isDoctor(resource.data.clinicId) || isCaja(resource.data.clinicId))
        && moduloActivo(resource.data.clinicId, 'laboratorio');
      allow delete: if isDoctor(resource.data.clinicId);
    }

    // ═══ /solicitudesUnificacion/{id} ══════════════════════════════
    match /solicitudesUnificacion/{solId} {
      // resource == null: mismo bypass que en /expedientes.
      allow read: if (resource == null && isAuth()) || isDoctor(resource.data.clinicId);
      allow create: if isDoctor(request.resource.data.clinicId)
        && request.resource.data.solicitadoPor == request.auth.token.email
        && request.resource.data.estado == 'pendiente';
      allow update: if isAdmin(resource.data.clinicId);
      allow delete: if isAdmin(resource.data.clinicId);
    }

    // ═══ /constancias/{id} ═════════════════════════════════════════
    match /constancias/{constanciaId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      allow read: if (resource == null && isAuth()) || isDoctor(resource.data.clinicId) || isCaja(resource.data.clinicId);
      allow create, update: if isDoctor(request.resource.data.clinicId)
        && moduloActivo(request.resource.data.clinicId, 'constancias');
      allow delete: if isAdmin(resource.data.clinicId);
    }

    // ═══ /referencias/{id} ═══════════════════════════════════════════
    // Referencia a Especialista o Emergencia, emitida desde la consulta, Caja
    // o Historial (ver prepararReferencia() en Expediente-Doctor.html).
    // Mismo patrón exacto que /constancias — reutiliza el módulo 'constancias'
    // en vez de crear un módulo nuevo, porque es el mismo tipo de documento
    // legal/administrativo emitido por el médico.
    match /referencias/{referenciaId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      allow read: if (resource == null && isAuth()) || isDoctor(resource.data.clinicId) || isCaja(resource.data.clinicId);
      allow create, update: if isDoctor(request.resource.data.clinicId)
        && moduloActivo(request.resource.data.clinicId, 'constancias');
      allow delete: if isAdmin(resource.data.clinicId);
    }

    // ═══ /electrocardiogramas/{id} ═════════════════════════════════
    match /electrocardiogramas/{ekgId} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      allow read: if (resource == null && isAuth()) || isDoctor(resource.data.clinicId) || isCaja(resource.data.clinicId);
      allow create, update: if isDoctor(request.resource.data.clinicId)
        && moduloActivo(request.resource.data.clinicId, 'ekg');
      allow delete: if isDoctor(resource.data.clinicId);
    }

    // ═══ /estadisticas/{id} ════════════════════════════════════════
    // Contadores agregados por clínica (ej. total de expedientes creados).
    match /estadisticas/{id} {
      // resource == null: mismo bypass que en /expedientes — un get() a un
      // id que no existe todavía no debe tronar la evaluación de la regla.
      allow read: if (resource == null && isAuth()) || isDoctor(resource.data.clinicId) || isCaja(resource.data.clinicId);
      allow write: if isDoctor(request.resource.data.clinicId) || isAdmin(request.resource.data.clinicId);
    }

    // ═══ /seguridad2FA/{uid} ═════════════════════════════════════════
    // Secreto TOTP y hashes de los códigos de recuperación de cada usuario
    // (functions/index.js, bloque 2FA). CERRADO por completo al cliente: solo
    // el Admin SDK entra acá. Si el propio usuario pudiera leer su secreto,
    // cualquier XSS en el portal se llevaría el segundo factor junto con la
    // sesión, y el 2FA dejaría de sumar nada sobre la contraseña.
    // El estado (sin el secreto) se espeja en /usuarios/{uid}.dosFactoresActivo,
    // que sí es legible, para que la interfaz sepa si está activo.
    match /seguridad2FA/{uid} {
      allow read, write: if false;
    }

    // ═══ /loginAttempts/{email} ══════════════════════════════════════
    // Rate limiting de login (functions/index.js: registrarIntentoLogin,
    // registrarLoginExitoso, verificarCodigoReset). Lectura pública a
    // propósito — Auth.html necesita saber si un correo está bloqueado
    // ANTES de que exista sesión (nadie ha iniciado sesión todavía en ese
    // punto). Solo expone count/lockedUntil, nada sensible. Escritura
    // SIEMPRE false: el conteo solo lo toca el Admin SDK desde las Cloud
    // Functions de arriba — si el cliente pudiera escribir aquí, cualquiera
    // resetearía su propio contador y el límite no protegería nada.
    match /loginAttempts/{email} {
      allow read: if true;
      allow write: if false;
    }

    // ═══ Bloqueo por defecto ═══════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
